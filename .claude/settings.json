{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm i)",
      "Bash(npm ci)",
      "Bash(npm start)",
      "Bash(npm run build)",
      "Bash(npm run build:staging)",
      "Bash(npm -w client run build)",
      "Bash(npx tsc --noEmit)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./client/.env)",
      "Read(./client/.env.*)",
      "Read(./server/.env)",
      "Read(./server/.env.*)",
      "Bash(npm run deploy:*)",
      "Bash(npm run predeploy:*)",
      "Bash(npm run postdeploy:*)"
    ]
  }
}
