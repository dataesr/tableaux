{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tableaux prototype board manifest",
  "description": "Proposed metadata for a generated board (client folder and server routes); it does not register or authorize a dashboard.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "description",
    "data_mode",
    "data_sources",
    "routes",
    "features"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "description": "Board folder name (client and server) and, at promotion, matching MongoDB boards.id.",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 50
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "data_mode": {
      "description": "How the board's routes read data. fixtures-dummy: invented values (UI must show a fictitious-data notice). fixtures-public-snapshot: a slice of a public source recorded in fixture_provenance. external-live: routes call an external public API with caching. approved-read-only-preview: routes read an owner-approved source.",
      "enum": [
        "fixtures-dummy",
        "fixtures-public-snapshot",
        "external-live",
        "approved-read-only-preview"
      ]
    },
    "data_sources": {
      "description": "Data sources read by the board's server routes. The browser never reads them directly.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "board-fixtures",
          "mongodb",
          "elasticsearch",
          "paysage",
          "ods",
          "external"
        ]
      }
    },
    "fixture_provenance": {
      "description": "Required when data_mode is fixtures-public-snapshot. Records where the fixture data came from.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "license"],
          "properties": {
            "source": { "type": "string", "minLength": 1 },
            "license": { "type": "string", "minLength": 1 },
            "retrievedAt": { "type": "string" },
            "url": { "type": "string" }
          }
        },
        { "type": "null" }
      ]
    },
    "routes": {
      "description": "Backend contract: the board's own server routes, mounted from server/src/router.js.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "path", "description"],
        "properties": {
          "method": {
            "enum": ["GET", "POST"]
          },
          "path": {
            "type": "string",
            "description": "Must start with /<id>/ where <id> is the board id.",
            "pattern": "^/[a-z0-9]+(?:-[a-z0-9]+)*/[A-Za-z0-9_\\-/{}]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "common_candidates": {
      "description": "Helpers that look reusable by other boards and may be proposed for extraction into server/src/commons or services after review. Dataset-specific logic stays in the board.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "reason"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "features": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 64
      }
    },
    "preview_approval": {
      "description": "Required by review policy, not sufficient authorization, when data_mode is approved-read-only-preview.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "source",
            "datasets"
          ],
          "properties": {
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "datasets": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "data_mode": {
            "const": "approved-read-only-preview"
          }
        },
        "required": ["data_mode"]
      },
      "then": {
        "required": ["preview_approval"],
        "properties": {
          "preview_approval": {
            "type": "object"
          },
          "data_sources": {
            "contains": {
              "enum": ["mongodb", "elasticsearch", "paysage", "ods"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "data_mode": {
            "enum": ["fixtures-dummy", "fixtures-public-snapshot"]
          }
        },
        "required": ["data_mode"]
      },
      "then": {
        "properties": {
          "data_sources": {
            "items": {
              "const": "board-fixtures"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "data_mode": {
            "const": "fixtures-public-snapshot"
          }
        },
        "required": ["data_mode"]
      },
      "then": {
        "required": ["fixture_provenance"],
        "properties": {
          "fixture_provenance": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "data_mode": {
            "const": "external-live"
          }
        },
        "required": ["data_mode"]
      },
      "then": {
        "properties": {
          "data_sources": {
            "contains": {
              "const": "external"
            }
          }
        }
      }
    }
  ]
}
